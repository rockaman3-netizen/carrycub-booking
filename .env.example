# Copy this file to .env.local and adjust values for local testing.
# .env.local is git-ignored and is never committed.

# Test-only admin password (see src/lib/admin-auth.ts).
# IMPORTANT: NEXT_PUBLIC_* variables are compiled into the client-side JS
# bundle and are visible to anyone who opens devtools — this is NOT real
# security, just a way to avoid a hardcoded password in source. Do not
# reuse a real password here. Real admin auth needs a server-side check.
NEXT_PUBLIC_ADMIN_PASSWORD=admin123

# When "true", the admin and driver login pages show a small dev hint
# pointing you at where to find test credentials. Leave unset/"false" for
# anything other than local development, since this is a plain client-side
# flag anyone can toggle off/on by inspecting the bundle anyway — but there
# is no reason to ship it on by default.
NEXT_PUBLIC_SHOW_TEST_HINTS=false

# ---------------------------------------------------------------------------
# Google Sheets, via an Apps Script Web App (server-only — never prefix
# these with NEXT_PUBLIC_). Read only by src/lib/sheets.ts, only ever
# imported from route handlers under src/app/api/**, so they never reach
# the browser. See APPS_SCRIPT_SETUP.md for how to deploy the script.
# ---------------------------------------------------------------------------

# The deployed Web App URL, ending in /exec.
APPS_SCRIPT_URL=

# The same random secret string you set as the API_SECRET script property
# in the Apps Script project.
APPS_SCRIPT_SECRET=
